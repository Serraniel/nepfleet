{
  "$id": "https://raw.githubusercontent.com/Serraniel/nepfleet/main/schemas/fleet.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Fleet is fleet.yaml.",
  "properties": {
    "apiVersion": {
      "const": "nepfleet/v1alpha1",
      "type": "string"
    },
    "kind": {
      "const": "Fleet",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z0-9]([a-z0-9_-]{0,61}[a-z0-9])?$",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "spec": {
      "additionalProperties": false,
      "description": "Spec holds the settings that apply to every stack.",
      "properties": {
        "egress": {
          "additionalProperties": false,
          "description": "Egress: hosts the containers must not reach (known telemetry by default, see TelemetryHosts).",
          "properties": {
            "block": {
              "description": "Block lists more host names to resolve to 0.0.0.0.",
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "type": [
                "array",
                "null"
              ]
            },
            "blockTelemetry": {
              "description": "BlockTelemetry resolves the known telemetry hosts (TelemetryHosts) to 0.0.0.0 in every service; on unless set to false.",
              "type": "boolean"
            }
          },
          "type": [
            "object",
            "null"
          ]
        },
        "ingressNetwork": {
          "default": "nepfleet_ingress",
          "description": "IngressNetwork is the external network Caddy and the stacks share.",
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "logging": {
          "additionalProperties": false,
          "description": "Logging is the log driver of every service that sets none itself, so container logs rotate instead of filling the disk.",
          "properties": {
            "driver": {
              "default": "json-file",
              "description": "Driver is a Docker log driver, e.g. json-file or local.",
              "type": [
                "string",
                "number",
                "boolean"
              ]
            },
            "enabled": {
              "description": "Enabled: false keeps the daemon's defaults (no logging section added).",
              "type": "boolean"
            },
            "options": {
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "description": "Options are the driver's options, e.g. max-size and max-file.",
              "type": [
                "object",
                "null"
              ]
            }
          },
          "type": [
            "object",
            "null"
          ]
        },
        "mirrors": {
          "description": "Mirrors are git URLs of second remotes the fleet repository is pushed to (nepfleet mirror), so it survives the loss of its main remote.",
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "type": [
            "array",
            "null"
          ]
        },
        "notifications": {
          "additionalProperties": false,
          "description": "Notifications: channels (shoutrrr URLs) and routes that pick which events go where (docs/notifications.md).",
          "properties": {
            "channels": {
              "additionalProperties": {
                "additionalProperties": false,
                "properties": {
                  "format": {
                    "default": "text",
                    "description": "Format json sends the raw event to a generic webhook.",
                    "enum": [
                      "",
                      "text",
                      "json"
                    ],
                    "type": "string"
                  },
                  "url": {
                    "description": "URL is a shoutrrr URL written here: only for URLs without secrets.",
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  },
                  "urlSecret": {
                    "description": "URLSecret names the key in fleet.secret.yaml holding the shoutrrr URL (it contains tokens).",
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  }
                },
                "type": "object"
              },
              "type": [
                "object",
                "null"
              ]
            },
            "routes": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "channels": {
                    "items": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    },
                    "type": [
                      "array",
                      "null"
                    ]
                  },
                  "events": {
                    "description": "Events are names or patterns (\"*\", \"apply.*\"); empty matches all.",
                    "items": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    },
                    "type": [
                      "array",
                      "null"
                    ]
                  },
                  "minSeverity": {
                    "enum": [
                      "",
                      "info",
                      "warning",
                      "error"
                    ],
                    "type": "string"
                  },
                  "stacks": {
                    "description": "Stacks limits the route to these stacks; empty matches all.",
                    "items": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    },
                    "type": [
                      "array",
                      "null"
                    ]
                  }
                },
                "required": [
                  "channels"
                ],
                "type": "object"
              },
              "type": [
                "array",
                "null"
              ]
            }
          },
          "type": [
            "object",
            "null"
          ]
        },
        "paths": {
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "description": "Paths names host folders that stacks share (a media share, a folder one app writes and another reads). Path inputs refer to them as @name.",
          "type": [
            "object",
            "null"
          ]
        },
        "secrets": {
          "additionalProperties": false,
          "properties": {
            "age": {
              "description": "Age recipients (public keys) that every secret file is encrypted to.",
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "type": [
                "array",
                "null"
              ]
            }
          },
          "type": [
            "object",
            "null"
          ]
        },
        "templateSources": {
          "items": {
            "additionalProperties": false,
            "oneOf": [
              {
                "required": [
                  "url"
                ]
              },
              {
                "required": [
                  "path"
                ]
              }
            ],
            "properties": {
              "name": {
                "pattern": "^[a-z0-9]([a-z0-9_-]{0,61}[a-z0-9])?$",
                "type": "string"
              },
              "path": {
                "description": "Path is a local directory, relative to the fleet repository.",
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "ref": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "url": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            "required": [
              "name"
            ],
            "type": "object"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "tz": {
          "default": "UTC",
          "description": "TZ is passed to stacks as ${TZ}.",
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "updates": {
          "additionalProperties": false,
          "properties": {
            "host": {
              "default": "off",
              "enum": [
                "",
                "off",
                "notify",
                "auto"
              ],
              "type": "string"
            },
            "images": {
              "default": "notify",
              "enum": [
                "",
                "off",
                "notify",
                "auto"
              ],
              "type": "string"
            }
          },
          "type": [
            "object",
            "null"
          ]
        },
        "uptimeKuma": {
          "description": "UptimeKuma instances get maintenance windows while stacks with their monitors are being changed (docs/maintenance.md).",
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "minLength": 1,
                "type": "string"
              },
              "passwordSecret": {
                "description": "PasswordSecret names the key in fleet.secret.yaml holding the password.",
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "rollingUpdates": {
                "default": "incident",
                "description": "RollingUpdates: what a swarm update whose monitored services all run two or more replicas gets, as it degrades rather than stops them: a warning incident on the status pages showing them, a maintenance window as for other updates, or nothing.",
                "enum": [
                  "",
                  "incident",
                  "maintenance",
                  "none"
                ],
                "type": "string"
              },
              "url": {
                "minLength": 1,
                "type": "string"
              },
              "username": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            "required": [
              "name",
              "url"
            ],
            "type": "object"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata"
  ],
  "title": "NepFleet fleet.yaml",
  "type": "object"
}
