{
  "$id": "https://raw.githubusercontent.com/Serraniel/nepfleet/main/schemas/template.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Template is the parsed template.yaml.",
  "properties": {
    "apiVersion": {
      "const": "nepfleet/v1alpha1",
      "type": "string"
    },
    "kind": {
      "const": "Template",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": false,
      "description": "Metadata describes the template for catalogues and the UI.",
      "properties": {
        "category": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "description": {
          "minLength": 1,
          "type": "string"
        },
        "homepage": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "icon": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "name": {
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
          "type": "string"
        },
        "source": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        "tier": {
          "description": "system | app",
          "enum": [
            "system",
            "app"
          ],
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "description",
        "name",
        "tier",
        "title"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "spec": {
      "additionalProperties": false,
      "description": "Spec is what NepFleet needs to install, update and migrate the stack.",
      "properties": {
        "compose": {
          "minLength": 1,
          "type": "string"
        },
        "files": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "dest": {
                "minLength": 1,
                "type": "string"
              },
              "src": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "dest",
              "src"
            ],
            "type": "object"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "generate": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "encoding": {
                "enum": [
                  "",
                  "base64url",
                  "hex",
                  "alnum"
                ],
                "type": "string"
              },
              "kind": {
                "description": "secret",
                "enum": [
                  "secret"
                ],
                "type": "string"
              },
              "length": {
                "maximum": 256,
                "minimum": 16,
                "type": "integer"
              },
              "name": {
                "pattern": "^[A-Z][A-Z0-9_]*$",
                "type": "string"
              }
            },
            "required": [
              "kind",
              "length",
              "name"
            ],
            "type": "object"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "hardware": {
          "description": "Hardware maps device and gpu inputs to services; NepFleet adds them to the rendered compose file only when the input has a value.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "input": {
                "description": "Input names a spec.inputs entry of type device or gpu.",
                "minLength": 1,
                "type": "string"
              },
              "services": {
                "description": "Services get the device or GPU.",
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "minItems": 1,
                "type": [
                  "array",
                  "null"
                ]
              },
              "target": {
                "description": "Target is the device path inside the container (device inputs; default: the same path as on the host).",
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            },
            "required": [
              "input",
              "services"
            ],
            "type": "object"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "images": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "description": "Name is the image without tag, as written in the compose file.",
                "pattern": "^[^:@]+$",
                "type": "string"
              },
              "track": {
                "description": "Track is the widest update NepFleet applies without a template change: patch, minor or major. Anything wider opens an issue in the template repo.",
                "enum": [
                  "patch",
                  "minor",
                  "major"
                ],
                "type": "string"
              }
            },
            "required": [
              "name",
              "track"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": [
            "array",
            "null"
          ]
        },
        "inputs": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "default": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "description": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "name": {
                "pattern": "^[A-Z][A-Z0-9_]*$",
                "type": "string"
              },
              "options": {
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                },
                "type": [
                  "array",
                  "null"
                ]
              },
              "pattern": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "title": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "type": {
                "enum": [
                  "string",
                  "text",
                  "secret",
                  "hostname",
                  "url",
                  "email",
                  "int",
                  "bool",
                  "enum",
                  "path",
                  "device",
                  "gpu"
                ],
                "type": "string"
              }
            },
            "required": [
              "name",
              "type"
            ],
            "type": "object"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "migrations": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "backup": {
                "description": "required | recommended | none",
                "enum": [
                  "required",
                  "recommended",
                  "none"
                ],
                "type": "string"
              },
              "description": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "from": {
                "minLength": 1,
                "type": "string"
              },
              "rollback": {
                "description": "restore | revert",
                "enum": [
                  "restore",
                  "revert"
                ],
                "type": "string"
              },
              "steps": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "deploy": {
                      "type": "boolean"
                    },
                    "name": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    },
                    "run": {
                      "items": {
                        "type": [
                          "string",
                          "number",
                          "boolean"
                        ]
                      },
                      "type": [
                        "array",
                        "null"
                      ]
                    },
                    "service": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    },
                    "wait": {
                      "description": "healthy",
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    }
                  },
                  "type": "object"
                },
                "minItems": 1,
                "type": [
                  "array",
                  "null"
                ]
              },
              "to": {
                "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$",
                "type": "string"
              }
            },
            "required": [
              "backup",
              "from",
              "rollback",
              "steps",
              "to"
            ],
            "type": "object"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "supports": {
          "additionalProperties": false,
          "description": "Supports flags which NepFleet integrations a template wires up.",
          "properties": {
            "arm64": {
              "type": "boolean"
            },
            "autoUpdate": {
              "type": "boolean"
            },
            "backup": {
              "type": "boolean"
            },
            "dashboard": {
              "type": "boolean"
            },
            "ingress": {
              "type": "boolean"
            },
            "logs": {
              "type": "boolean"
            },
            "monitoring": {
              "type": "boolean"
            },
            "sso": {
              "type": "boolean"
            },
            "statusPage": {
              "type": "boolean"
            },
            "swarm": {
              "type": "boolean"
            }
          },
          "type": [
            "object",
            "null"
          ]
        },
        "version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$",
          "type": "string"
        },
        "volumes": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "backup": {
                "type": "boolean"
              },
              "name": {
                "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
                "type": "string"
              },
              "shared": {
                "description": "Shared marks data that must follow the service across swarm nodes.",
                "type": "boolean"
              },
              "snapshot": {
                "description": "Snapshot: false keeps the volume out of the data snapshot taken before an apply (large media, caches).",
                "type": "boolean"
              }
            },
            "required": [
              "name"
            ],
            "type": "object"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "compose",
        "images",
        "version"
      ],
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "NepFleet template.yaml",
  "type": "object"
}
