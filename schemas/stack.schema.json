{
  "$id": "https://raw.githubusercontent.com/Serraniel/nepfleet/main/schemas/stack.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Stack is stacks/<name>/stack.yaml (or system/<name>/stack.yaml).",
  "properties": {
    "apiVersion": {
      "const": "nepfleet/v1alpha1",
      "type": "string"
    },
    "kind": {
      "const": "Stack",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z0-9]([a-z0-9_-]{0,61}[a-z0-9])?$",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "spec": {
      "additionalProperties": false,
      "description": "StackSpec says where and how a stack runs.",
      "properties": {
        "access": {
          "additionalProperties": false,
          "description": "Access says how the stack's web UI is reached: through Caddy on its domain (default) or on a port of the host on the LAN.",
          "properties": {
            "mode": {
              "default": "domain",
              "description": "Mode: domain (Caddy, as the template's labels say) or port (a host port on the LAN, no Caddy).",
              "enum": [
                "",
                "domain",
                "port"
              ],
              "type": "string"
            },
            "port": {
              "description": "Port is the host port in mode port; nepfleet new picks a free one.",
              "type": "integer"
            }
          },
          "type": [
            "object",
            "null"
          ]
        },
        "apply": {
          "default": "manual",
          "description": "manual | auto",
          "enum": [
            "",
            "manual",
            "auto"
          ],
          "type": "string"
        },
        "egress": {
          "additionalProperties": false,
          "description": "Egress limits what a stack's containers reach on the internet.",
          "properties": {
            "allow": {
              "description": "Allow lists host names or addresses (or CIDR ranges) containers may reach in mode enforce. Both lists count.",
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "type": [
                "array",
                "null"
              ]
            },
            "block": {
              "description": "Block lists more host names to resolve to 0.0.0.0.",
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "type": [
                "array",
                "null"
              ]
            },
            "blockTelemetry": {
              "description": "BlockTelemetry resolves the known telemetry hosts (TelemetryHosts) to 0.0.0.0 in every service; on unless set to false.",
              "type": "boolean"
            },
            "mode": {
              "description": "Mode is off (the default) or enforce: containers reach only private networks and what is allowed. A stack's mode replaces the fleet's.",
              "enum": [
                "",
                "off",
                "enforce"
              ],
              "type": "string"
            }
          },
          "type": [
            "object",
            "null"
          ]
        },
        "logging": {
          "additionalProperties": false,
          "description": "Logging overrides the fleet's default log settings for this stack.",
          "properties": {
            "driver": {
              "default": "json-file",
              "description": "Driver is a Docker log driver, e.g. json-file or local.",
              "type": [
                "string",
                "number",
                "boolean"
              ]
            },
            "enabled": {
              "description": "Enabled: false keeps the daemon's defaults (no logging section added).",
              "type": "boolean"
            },
            "options": {
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "description": "Options are the driver's options, e.g. max-size and max-file.",
              "type": [
                "object",
                "null"
              ]
            }
          },
          "type": [
            "object",
            "null"
          ]
        },
        "mode": {
          "default": "compose",
          "description": "compose | swarm",
          "enum": [
            "",
            "compose",
            "swarm"
          ],
          "type": "string"
        },
        "snapshot": {
          "default": "auto",
          "description": "Snapshot: auto copies the volumes before an apply that recreates running services and restores them on rollback; off skips that.",
          "enum": [
            "",
            "auto",
            "off"
          ],
          "type": "string"
        },
        "snapshotExclude": {
          "description": "SnapshotExclude lists mount paths in the containers never copied.",
          "items": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "type": [
            "array",
            "null"
          ]
        },
        "target": {
          "minLength": 1,
          "type": "string"
        },
        "template": {
          "additionalProperties": false,
          "description": "TemplateRef selects a template from a source.",
          "properties": {
            "name": {
              "minLength": 1,
              "type": "string"
            },
            "source": {
              "minLength": 1,
              "type": "string"
            },
            "version": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "required": [
            "name",
            "source"
          ],
          "type": [
            "object",
            "null"
          ]
        },
        "updates": {
          "default": "notify",
          "description": "off | notify | auto",
          "enum": [
            "",
            "off",
            "notify",
            "auto"
          ],
          "type": "string"
        },
        "values": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              {
                "additionalProperties": false,
                "oneOf": [
                  {
                    "required": [
                      "value"
                    ]
                  },
                  {
                    "required": [
                      "secret"
                    ]
                  }
                ],
                "properties": {
                  "from": {
                    "description": "The stack whose value or secret is used.",
                    "pattern": "^[a-z0-9]([a-z0-9_-]{0,61}[a-z0-9])?$",
                    "type": "string"
                  },
                  "secret": {
                    "description": "Secret is the name of a secret of that stack, generated ones included.",
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  },
                  "value": {
                    "description": "Value is the name of a value (or template input default) of that stack.",
                    "type": [
                      "string",
                      "number",
                      "boolean"
                    ]
                  }
                },
                "required": [
                  "from"
                ],
                "type": "object"
              }
            ]
          },
          "description": "Values are template inputs (or env variables of a plain stack): a literal, or {from: <stack>, value|secret: <name>} to use another stack's value or secret.",
          "type": [
            "object",
            "null"
          ]
        },
        "volumes": {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {
              "path": {
                "description": "Path is a folder inside the share (empty = the share itself).",
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "storage": {
                "description": "Storage names a fleet.yaml spec.storage entry.",
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "storage"
            ],
            "type": "object"
          },
          "description": "Egress: hosts the containers must not reach (known telemetry by default, see TelemetryHosts). Volumes puts compose volumes on network storage from fleet.yaml spec.storage, e.g. media: {storage: nas, path: /movies}.",
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "target"
      ],
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "NepFleet stack.yaml",
  "type": "object"
}
