# Maintainer: Serraniel
# NepFleet built from main, for testing before a release. Its version is
# "edge": it installs and updates machines to the signed :edge image of main.
#   cd packaging/arch/nepfleet-git && makepkg -si
pkgname=nepfleet-git
pkgver=0.3.4.r38.g80f3307
pkgrel=1
pkgdesc="Self-hosted fleet manager for Docker Compose and Swarm stacks (built from main)"
arch=('x86_64' 'aarch64')
url="https://github.com/Serraniel/nepfleet"
license=('AGPL-3.0-or-later')
depends=('git' 'openssh')
makedepends=('go')
optdepends=('docker: run stacks on this machine'
            'docker-compose: run stacks on this machine'
            'sops: secrets, when not run in its container'
            'age: secrets, when not run in its container'
            'syft: sbom --contents for images without an SBOM attestation')
provides=('nepfleet')
conflicts=('nepfleet' 'nepfleet-bin')
source=("$pkgname::git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd "$pkgname"
  git describe --long --tags --abbrev=7 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  cd "$pkgname"
  export CGO_ENABLED=0 GOFLAGS="-trimpath -mod=readonly -modcacherw"
  go build -ldflags "-buildid= -s -w -X main.version=edge -X main.commit=$(git rev-parse HEAD)" -o nepfleet ./cmd/nepfleet
}

package() {
  cd "$pkgname"
  install -Dm755 nepfleet "$pkgdir/usr/bin/nepfleet"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
